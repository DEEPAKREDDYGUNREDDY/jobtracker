# Copy to .env (or export these) before running locally
DB_URL=jdbc:postgresql://localhost:5432/job_tracker
DB_USERNAME=postgres
DB_PASSWORD=postgres

JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_MS=86400000

ALLOWED_ORIGINS=http://localhost:3000

PORT=8080

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Enable the Gmail API on the same project, and add GOOGLE_REDIRECT_URI as an authorized redirect URI.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/gmail/callback

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-haiku-4-5

# How often the scheduler polls all connected Gmail accounts (ms)
GMAIL_SYNC_INTERVAL_MS=300000
# Minimum Claude confidence required to auto-create/update an application (0-1)
GMAIL_CONFIDENCE_THRESHOLD=0.6
# On first sync for a newly connected account, how far back to look for mail
GMAIL_INITIAL_LOOKBACK_DAYS=30
